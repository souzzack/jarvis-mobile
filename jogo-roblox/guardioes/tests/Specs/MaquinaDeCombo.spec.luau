-- NÃO EXECUTADO. Máquina de combo com a Espada e as regras globais (tempos da Config/Armas/Espada).
-- Corte1: preparo 0,12 · golpe 0,10 · recuperação 0,22 (fim em 0,44). Janela de continuar 0,6 s; buffer 0,35 s.

return function(T, M)
	local MC, arma, cfg = M.MaquinaDeCombo, M.Espada, M.CfgCombate

	T.caso("ataque em ocioso inicia o golpe 1", function()
		local m = MC.nova(0)
		local ok, motivo = MC.pedirAtaque(m, arma, cfg, 0, false)
		T.verdade(ok)
		T.igual(motivo, "iniciado")
		T.igual(m.estado, "Preparo")
		T.igual(m.golpe, 1)
	end)

	T.caso("preparo → golpe (evento) → recuperação → ocioso", function()
		local m = MC.nova(0)
		MC.pedirAtaque(m, arma, cfg, 0, false)
		T.igual(#MC.atualizar(m, arma, cfg, 0.05), 0, "nada antes do fim do preparo")
		local ev = MC.atualizar(m, arma, cfg, 0.13)
		T.igual(#ev, 1)
		T.igual(ev[1].tipo, "Golpe")
		T.igual(m.estado, "Golpe")
		MC.atualizar(m, arma, cfg, 0.25)
		T.igual(m.estado, "Recuperacao")
		ev = MC.atualizar(m, arma, cfg, 0.45)
		T.igual(ev[1].tipo, "FimGolpe")
		T.igual(m.estado, "Ocioso")
	end)

	T.caso("dentro da janela o próximo pedido continua o combo; fora dela recomeça", function()
		local m = MC.nova(0)
		MC.pedirAtaque(m, arma, cfg, 0, false)
		MC.atualizar(m, arma, cfg, 0.5)
		MC.pedirAtaque(m, arma, cfg, 0.5, false)
		T.igual(m.golpe, 2, "continuou")
		local m2 = MC.nova(0)
		MC.pedirAtaque(m2, arma, cfg, 0, false)
		MC.atualizar(m2, arma, cfg, 1.2)
		MC.pedirAtaque(m2, arma, cfg, 1.2, false)
		T.igual(m2.golpe, 1, "recomeçou")
	end)

	T.caso("pedido cedo é recusado; perto do fim fica guardado e encadeia", function()
		local m = MC.nova(0)
		MC.pedirAtaque(m, arma, cfg, 0, false)
		local ok, motivo = MC.pedirAtaque(m, arma, cfg, 0.05, false) -- faltam 0,39 s > 0,35
		T.falso(ok)
		T.igual(motivo, "cedo")
		ok, motivo = MC.pedirAtaque(m, arma, cfg, 0.12, false) -- faltam 0,32 s
		T.verdade(ok)
		T.igual(motivo, "guardado")
		-- salto grande de tempo: Golpe1, FimGolpe1, Golpe2, FimGolpe2
		local ev = MC.atualizar(m, arma, cfg, 1.0)
		T.igual(#ev, 4)
		T.igual(ev[3].tipo, "Golpe")
		T.igual(ev[3].golpe, 2)
		T.igual(m.estado, "Ocioso")
	end)

	T.caso("ataque pesado usa o golpe -1", function()
		local m = MC.nova(0)
		MC.pedirAtaque(m, arma, cfg, 0, true)
		T.igual(m.golpe, MC.PESADO)
	end)

	T.caso("esquiva: i-frames só entre 0,05 e 0,30 s, e recarga", function()
		local m = MC.nova(0)
		T.verdade((MC.pedirEsquiva(m, cfg, 0)))
		T.falso(MC.invulneravel(m, cfg, 0.02), "antes da janela")
		T.verdade(MC.invulneravel(m, cfg, 0.10), "na janela")
		T.falso(MC.invulneravel(m, cfg, 0.35), "depois da janela")
		MC.atualizar(m, arma, cfg, 0.5)
		T.igual(m.estado, "Ocioso")
		local ok, motivo = MC.pedirEsquiva(m, cfg, 0.5) -- liberada só em 0,80
		T.falso(ok)
		T.igual(motivo, "recarga")
		T.verdade((MC.pedirEsquiva(m, cfg, 0.85)))
	end)

	T.caso("não esquiva na janela ativa do golpe; esquiva no preparo cancela o golpe", function()
		local m = MC.nova(0)
		MC.pedirAtaque(m, arma, cfg, 0, false)
		MC.atualizar(m, arma, cfg, 0.15)
		T.igual(m.estado, "Golpe")
		T.falso((MC.pedirEsquiva(m, cfg, 0.15)))
		local m2 = MC.nova(0)
		MC.pedirAtaque(m2, arma, cfg, 0, false)
		T.verdade((MC.pedirEsquiva(m2, cfg, 0.05)))
		T.igual(m2.golpe, 0)
	end)

	T.caso("defesa: aparar só nos primeiros 0,18 s", function()
		local m = MC.nova(0)
		T.verdade((MC.iniciarDefesa(m, 0)))
		T.verdade(MC.defendendo(m))
		T.verdade(MC.aparando(m, cfg, 0.10))
		T.falso(MC.aparando(m, cfg, 0.20))
		MC.soltarDefesa(m, 0.3)
		T.igual(m.estado, "Ocioso")
	end)

	T.caso("atordoado não ataca e volta a ocioso no fim", function()
		local m = MC.nova(0)
		MC.atordoar(m, 1.2, 0)
		local ok, motivo = MC.pedirAtaque(m, arma, cfg, 0.5, false)
		T.falso(ok)
		T.igual(motivo, "Atordoado")
		local ev = MC.atualizar(m, arma, cfg, 1.3)
		T.igual(ev[1].tipo, "FimAtordoado")
		T.igual(m.estado, "Ocioso")
	end)

	local function comboCompleto(acertos: { boolean })
		local m = MC.nova(0)
		MC.pedirAtaque(m, arma, cfg, 0, false)
		MC.atualizar(m, arma, cfg, 0.13)
		MC.registrarResultado(m, acertos[1])
		MC.atualizar(m, arma, cfg, 0.45)
		MC.pedirAtaque(m, arma, cfg, 0.45, false)
		MC.atualizar(m, arma, cfg, 0.60)
		MC.registrarResultado(m, acertos[2])
		MC.atualizar(m, arma, cfg, 0.95)
		MC.pedirAtaque(m, arma, cfg, 0.95, false)
		return m
	end

	T.caso("combo perfeito só se nenhum golpe anterior errou", function()
		local m = comboCompleto({ true, true })
		T.igual(m.golpe, 3)
		T.verdade(MC.comboPerfeito(m, arma, 3))
		local m2 = comboCompleto({ false, true })
		T.igual(m2.golpe, 3)
		T.falso(MC.comboPerfeito(m2, arma, 3))
	end)
end
