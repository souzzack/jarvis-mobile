-- NÃO EXECUTADO. Companhias (guildas): cargos, convites, cofre com limites, devoluções, liderança e dissolução.

return function(T, M)
	local C = M.Companhia
	local EMB = { forma = "Escudo", cor = "#4EA8FF", simbolo = "Raio" }
	local L, O, MB, R = 1, 2, 3, 4 -- líder, oficial, membro, recruta
	local DIA = 86400

	local function montar()
		local c = C.nova("c1", "Vigias", EMB, L, 0)
		for _, uid in { O, MB, R } do
			T.verdade(C.convidar(c, L, uid, 0))
			T.verdade(C.aceitar(c, uid, 1))
		end
		T.verdade(C.definirCargo(c, L, O, "Oficial", 2))
		T.verdade(C.definirCargo(c, L, MB, "Membro", 2))
		return c
	end

	T.caso("nome e emblema só com peças aprovadas", function()
		T.verdade(C.nomeValido("Vigias do Céu"))
		T.falso(C.nomeValido("ab"), "curto")
		T.falso(C.nomeValido(string.rep("a", 21)), "longo")
		T.falso(C.nomeValido("<b>x</b>"), "marcação")
		T.falso(C.nomeValido(" Vigias"), "espaço no começo")
		T.verdade(C.emblemaValido(EMB))
		T.falso(C.emblemaValido({ forma = "Escudo", cor = "#000000", simbolo = "Raio" }), "cor fora da lista")
		T.falso(C.emblemaValido("Escudo"))
	end)

	T.caso("convite: só quem pode convida; expira em 24 h; quem entra é Recruta", function()
		local c = montar()
		T.igual(C.cargo(c, R), "Recruta")
		local ok, m = C.convidar(c, MB, 9, 10)
		T.falso(ok)
		T.igual(m, "semPermissao")
		T.verdade(C.convidar(c, O, 9, 10), "oficial convida")
		local ok2, m2 = C.aceitar(c, 9, 10 + C.CONVITE_SEG + 1)
		T.falso(ok2)
		T.igual(m2, "semConvite")
		T.igual(select(2, C.convidar(c, L, MB, 10)), "jaMembro")
	end)

	T.caso("expulsar: só cargo acima; devolve os depósitos (nada é confiscado)", function()
		local c = montar()
		T.verdade(C.depositar(c, R, "FragmentoDeFaisca", 7, 5))
		T.verdade(C.depositar(c, MB, "FragmentoDeFaisca", 3, 5))
		local ok, m = C.expulsar(c, O, L, 6)
		T.falso(ok, "oficial não expulsa o líder")
		T.igual(m, "semPermissao")
		T.falso((C.expulsar(c, MB, R, 6)), "membro não expulsa")
		local ok2, _, dev = C.expulsar(c, O, R, 6)
		T.verdade(ok2)
		T.igual(dev.FragmentoDeFaisca, 7)
		T.igual(C.cargo(c, R), nil)
		T.igual(C.totaisDoCofre(c).FragmentoDeFaisca.qtd, 3, "o depósito dos outros fica")
	end)

	T.caso("sair devolve; o líder não sai sem transferir", function()
		local c = montar()
		C.depositar(c, MB, "PenaDeRaia", 2, 5)
		local _, _, dev = C.sair(c, MB, 6)
		T.igual(dev.PenaDeRaia, 2)
		local ok, m = C.sair(c, L, 6)
		T.falso(ok)
		T.igual(m, "liderNaoSai")
	end)

	T.caso("cofre: recruta só deposita; membro só retira lotes livres", function()
		local c = montar()
		C.depositar(c, L, "FragmentoDeFaisca", 30, 5)
		T.igual(select(2, C.retirar(c, R, "FragmentoDeFaisca", 1, 0, 6)), "semPermissao")
		T.igual(select(2, C.retirar(c, MB, "FragmentoDeFaisca", 1, 0, 6)), "semItem", "ainda não é livre")
		T.verdade(C.marcar(c, L, "FragmentoDeFaisca", "livre", 7))
		local ok, _, n = C.retirar(c, MB, "FragmentoDeFaisca", 5, 0, 8)
		T.verdade(ok)
		T.igual(n, 5)
		T.igual(C.totaisDoCofre(c).FragmentoDeFaisca.qtd, 25)
		T.falso((C.marcar(c, O, "FragmentoDeFaisca", "travado", 9)), "só o líder marca")
	end)

	T.caso("travado: oficial não tira; líder tira", function()
		local c = montar()
		C.depositar(c, MB, "NucleoDeTempestade", 4, 5)
		C.marcar(c, L, "NucleoDeTempestade", "travado", 6)
		T.igual(select(2, C.retirar(c, O, "NucleoDeTempestade", 1, 0, 7)), "semItem")
		local ok, _, n = C.retirar(c, L, "NucleoDeTempestade", 9, 0, 7)
		T.verdade(ok)
		T.igual(n, 4, "tira só o que existe")
		T.igual(C.totaisDoCofre(c).NucleoDeTempestade, nil)
	end)

	T.caso("limite diário por pessoa (oficial 50, membro 20) e vira no dia seguinte", function()
		local c = montar()
		C.depositar(c, L, "FragmentoDeFaisca", 200, 5)
		C.marcar(c, L, "FragmentoDeFaisca", "livre", 5)
		local _, _, n1 = C.retirar(c, MB, "FragmentoDeFaisca", 15, 0, 6)
		local _, _, n2 = C.retirar(c, MB, "FragmentoDeFaisca", 15, 0, 7)
		T.igual(n1 + n2, 20)
		T.igual(select(2, C.retirar(c, MB, "FragmentoDeFaisca", 1, 0, 8)), "limiteDiario")
		local ok = C.retirar(c, MB, "FragmentoDeFaisca", 1, 1, DIA + 1)
		T.verdade(ok, "dia novo")
		local _, _, n3 = C.retirar(c, O, "FragmentoDeFaisca", 80, 0, 9)
		T.igual(n3, 50)
		local _, _, n4 = C.retirar(c, L, "FragmentoDeFaisca", 60, 0, 9)
		T.igual(n4, 60, "líder sem limite")
	end)

	T.caso("quantidades inválidas são recusadas", function()
		local c = montar()
		T.igual(select(2, C.depositar(c, L, "X", 0, 1)), "quantidade")
		T.igual(select(2, C.depositar(c, L, "X", 1.5, 1)), "quantidade")
		T.igual(select(2, C.retirar(c, L, "X", -3, 0, 1)), "quantidade")
	end)

	T.caso("transferência de liderança leva 48 h e pode ser cancelada", function()
		local c = montar()
		T.verdade(C.iniciarTransferencia(c, L, O, 100))
		T.igual(C.atualizar(c, 100 + C.TRANSFERENCIA_SEG - 1), nil)
		T.verdade(C.cancelarTransferencia(c, L, 200))
		T.igual(C.atualizar(c, 100 + C.TRANSFERENCIA_SEG + 1), nil, "cancelada: nada muda")
		C.iniciarTransferencia(c, L, O, 300)
		T.igual(C.atualizar(c, 300 + C.TRANSFERENCIA_SEG), "Transferida")
		T.igual(C.cargo(c, O), "Lider")
		T.igual(C.cargo(c, L), "Oficial", "o antigo líder vira oficial")
	end)

	T.caso("dissolução: 2 confirmações + 72 h; tudo volta a quem depositou", function()
		local c = montar()
		C.depositar(c, MB, "FragmentoDeFaisca", 4, 1)
		C.depositar(c, R, "FragmentoDeFaisca", 6, 1)
		C.depositar(c, MB, "PenaDeRaia", 1, 1)
		T.igual(select(2, C.pedirDissolucao(c, O, 10)), "semPermissao")
		T.igual(select(2, C.pedirDissolucao(c, L, 10)), "confirme")
		T.igual(C.atualizar(c, 10 + C.DISSOLUCAO_SEG * 2), nil, "só pedir não agenda")
		T.igual(select(2, C.pedirDissolucao(c, L, 20)), "agendada")
		T.igual(C.atualizar(c, 20 + C.DISSOLUCAO_SEG - 1), nil)
		local r, dev = C.atualizar(c, 20 + C.DISSOLUCAO_SEG)
		T.igual(r, "Dissolvida")
		T.igual(dev[MB].FragmentoDeFaisca, 4)
		T.igual(dev[MB].PenaDeRaia, 1)
		T.igual(dev[R].FragmentoDeFaisca, 6)
		T.verdade(c.dissolvida)
		T.igual(#c.cofre, 0)
		T.falso((C.aceitar(c, 99, 30)), "ninguém entra numa dissolvida")
	end)

	T.caso("devoluções guardadas no registro somam e o log tem limite", function()
		local c = montar()
		C.guardarDevolucao(c, R, { A = 2 })
		C.guardarDevolucao(c, R, { A = 3, B = 1 })
		C.guardarDevolucao(c, R, {})
		T.igual(c.aDevolver[tostring(R)].A, 5)
		T.igual(c.aDevolver[tostring(R)].B, 1)
		for i = 1, 300 do
			C.depositar(c, L, "X", 1, i)
		end
		T.igual(#c.log, C.LOG_MAX)
	end)

	T.caso("nível sobe com XP (1000 × nível)", function()
		local c = montar()
		T.falso(C.ganharXp(c, 999))
		T.verdade(C.ganharXp(c, 1))
		T.igual(c.nivel, 2)
		T.verdade(C.ganharXp(c, 2000))
		T.igual(c.nivel, 3)
		T.igual(c.xp, 0)
		T.falso(C.ganharXp(c, -5))
	end)
end
