[[1.35, 3.48, "DAVI", "Pai, eles estão brigando de novo."], [4.21, 5.07, "DEUS", "Eu estou ouvindo."], [5.38, 6.71, "DEUS", "Tô aqui do seu lado."], [7.41, 8.47, "DAVI", "Eu coloquei o fone,"], [8.76, 10.87, "DAVI", "sem música, só pra não ouvir."], [11.45, 13.22, "DEUS", "Não precisa se esconder de mim."], [14.24, 16.25, "DAVI", "Pai, eles vão se separar?"], [16.83, 19.14, "DEUS", "Eu não vou te prometer o que é escolha deles,"], [19.51, 21.72, "DEUS", "mas vou te prometer o que é escolha minha."], [22.24, 22.67, "DAVI", "O quê?"], [23.26, 25.33, "DEUS", "Eu não vou embora. Nunca."], [26.32, 28.1, "DAVI", "Às vezes eu acho que é por minha causa."], [28.43, 29.38, "DAVI", "Se eu fosse melhor,"], [29.67, 30.88, "DAVI", "se eu tirasse nota melhor,"], [31.23, 32.2, "DAVI", "eles não brigariam."], [32.93, 34.32, "DEUS", "Davi, olha pra mim."], [34.77, 36.2, "DEUS", "Isso não é culpa sua."], [36.35, 37.16, "DEUS", "Nunca foi."], [37.45, 38.42, "DEUS", "Você é filho."], [38.65, 39.6, "DEUS", "Não é o conserto."], [40.51, 41.56, "DAVI", "Não é culpa minha?"], [42.21, 42.76, "DEUS", "Não é."], [42.99, 45.2, "DEUS", "Você não precisa carregar o que não é seu."], [46.05, 46.72, "DEUS", "Vinde a mim."], [47.03, 51.58, "DEUS", "Todos os que estão cansados e sobrecarregados e eu vos aliviarei."], [52.26, 53.65, "DAVI", "Eu tô cansado, Pai,"], [53.76, 54.97, "DAVI", "muito cansado."], [55.45, 56.03, "DEUS", "Eu sei."], [56.32, 57.61, "DEUS", "Então deixa eu carregar."], [57.78, 59.63, "DEUS", "Você só precisa ser criança."], [60.67, 62.15, "DAVI", "E se um dia eu ficar sem casa,"], [62.26, 63.35, "DAVI", "sem os dois juntos?"], [64.09, 66.22, "DEUS", "Ainda que pai e mãe te deixem,"], [66.43, 67.3, "DEUS", "eu te acolho."], [67.73, 69.76, "DEUS", "Comigo você sempre tem casa."], [70.6, 72.35, "DAVI", "O Senhor fica aqui até a briga acabar?"], [72.98, 73.95, "DEUS", "Fico até depois."], [74.3, 74.91, "DEUS", "Não temas."], [75.12, 76.11, "DEUS", "Eu estou contigo."], [76.36, 77.09, "DEUS", "Eu te seguro."], [78.82, 79.31, "DAVI", "Parou."], [80.3, 80.97, "DEUS", "Dorme, filho."], [81.36, 83.21, "DEUS", "Amanhã eu cuido de amanhã."]]