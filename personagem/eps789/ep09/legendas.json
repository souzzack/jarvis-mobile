[[0.95, 3.34, "DAVI", "Pai, eu tô com muita raiva."], [4.01, 4.68, "DEUS", "Eu sei."], [5.09, 5.8, "DEUS", "Pode falar."], [6.55, 8.3, "DAVI", "O Gabriel era meu melhor amigo."], [8.59, 10.06, "DAVI", "Eu contei um segredo pra ele,"], [10.11, 10.98, "DAVI", "só pra ele."], [11.54, 13.19, "DAVI", "E ele mandou pro grupo da sala,"], [13.36, 14.57, "DAVI", "todo mundo riu de mim."], [15.48, 16.13, "DEUS", "Eu vi."], [16.56, 17.91, "DEUS", "E doeu em mim também."], [18.67, 20.03, "DAVI", "Eu nunca vou perdoar ele,"], [20.05, 20.56, "DAVI", "nunca!"], [21.46, 23.56, "DEUS", "Posso te contar de um amigo que me traiu?"], [24.13, 24.47, "DAVI", "Quem?"], [25.11, 28.0, "DEUS", "Pedro, ele jurou que nunca ia me deixar."], [28.31, 31.8, "DEUS", "Na mesma noite, falou três vezes que nem me conhecia."], [32.76, 33.93, "DAVI", "E o Senhor perdoou?"], [34.62, 35.29, "DEUS", "Perdoei."], [35.7, 38.61, "DEUS", "E depois, fiz um café da manhã para ele na praia."], [39.3, 40.43, "DAVI", "Mas eu não sou o Senhor,"], [40.66, 41.47, "DAVI", "eu não consigo."], [42.11, 42.66, "DEUS", "Eu sei."], [42.89, 45.16, "DEUS", "Por isso, eu não te peço para fazer sozinho."], [45.84, 48.15, "DEUS", "Perdoar não é dizer que não doeu."], [48.42, 51.15, "DEUS", "É parar de carregar a pedra que ele te jogou."], [51.91, 54.31, "DAVI", "Então eu tenho que voltar a ser amigo dele como antes?"], [54.95, 55.57, "DEUS", "Não."], [55.84, 57.39, "DEUS", "Perdoar é uma coisa."], [57.62, 59.49, "DEUS", "Confiar de novo é outra."], [59.76, 60.83, "DEUS", "E ela leva tempo."], [61.45, 62.74, "DEUS", "No que depender de você,"], [62.93, 64.34, "DEUS", "tenha paz com todos."], [65.22, 67.26, "DAVI", "E se eu perdoar e a raiva voltar amanhã?"], [67.81, 69.32, "DEUS", "Aí você perdoa de novo."], [69.55, 71.34, "DEUS", "Pedro me perguntou quantas vezes?"], [71.65, 73.96, "DEUS", "Eu disse setenta vezes sete."], [74.45, 75.78, "DAVI", "Isso é muita vez!"], [76.48, 76.83, "DEUS", "É."], [77.02, 79.65, "DEUS", "E eu te perdoo muito mais vezes que isso."], [80.24, 82.13, "DEUS", "Perdoe como eu te perdoei."], [83.08, 84.99, "DAVI", "Tá, eu não consigo hoje inteiro."], [85.18, 86.29, "DAVI", "Mas eu quero conseguir."], [87.01, 88.2, "DEUS", "Isso já é o começo."], [88.49, 90.64, "DEUS", "E a pedra já está ficando mais leve, olha."], [91.74, 93.09, "DAVI", "Ela tá virando areia."], [93.73, 96.34, "DEUS", "É assim que o perdão funciona. Devagar."], [96.63, 97.3, "DEUS", "Mas funciona."]]