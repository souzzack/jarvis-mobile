[[0.95, 2.84, "DAVI", "Pai, o Senhor tá aí?"], [3.33, 4.95, "DEUS", "Tô sempre aqui, Davi."], [6.23, 8.1, "DAVI", "Hoje no recreio escolheram os times,"], [8.57, 9.48, "DAVI", "e sobrou eu."], [10.12, 10.83, "DAVI", "De novo?"], [11.88, 12.48, "DEUS", "Eu vi."], [13.02, 14.12, "DAVI", "Viu e não fez nada?"], [15.25, 15.68, "DEUS", "Fiz."], [16.35, 19.48, "DEUS", "Fiquei sentado do seu lado no banco o recreio inteiro."], [20.15, 21.36, "DAVI", "Eu não vi o Senhor lá."], [21.94, 24.77, "DEUS", "Eu sou muito bom em ficar quietinho."], [25.61, 27.26, "DAVI", "O Lucas tem um monte de amigo."], [27.53, 29.08, "DAVI", "Todo mundo quer sentar com ele."], [29.79, 31.17, "DAVI", "Acho que ninguém gosta de mim."], [32.08, 34.01, "DEUS", "Davi, me mostra a sua mão."], [34.53, 37.26, "DEUS", "Sabia que o seu nome tá escrito na palma da minha?"], [37.85, 38.5, "DAVI", "Escrito?"], [38.67, 39.48, "DAVI", "Tipo de caneta?"], [40.55, 42.18, "DEUS", "Não sai nem no banho."], [43.19, 44.88, "DAVI", "O Senhor me escolheria pro time?"], [45.6, 47.279999999999994, "DEUS", "Filho, eu te escolhi"], [47.3, 49.29, "DEUS", "antes do time existir,"], [49.52, 50.53, "DEUS", "antes da escola,"], [50.98, 52.25, "DEUS", "antes do mundo."], [52.94, 53.97, "DAVI", "Antes do mundo?"], [54.52, 55.69, "DEUS", "Antes do mundo."], [55.71, 58.16, "DEUS", "E sabe o que eu faço quando penso em você?"], [58.65, 59.11, "DAVI", "O quê?"], [59.64, 60.47, "DEUS", "Eu canto."], [60.91, 62.2, "DAVI", "O Senhor canta?"], [62.37, 62.9, "DAVI", "Que música?"], [63.6, 64.91, "DEUS", "Essa é segredo."], [65.76, 68.42, "DAVI", "Pai, e se amanhã ninguém me escolher de novo?"], [69.08, 70.23, "DEUS", "Então, olha pro banco."], [70.46, 72.51, "DEUS", "Talvez tenha mais alguém sozinho lá."], [73.36, 75.39, "DEUS", "Eu também já fiquei sozinho, Davi."], [75.7, 78.35, "DEUS", "Meus amigos correram quando eu mais precisei."], [78.58, 79.81, "DEUS", "Eu sei como dói."], [80.29, 81.75, "DAVI", "O Senhor sentiu isso também?"], [82.21, 82.94, "DEUS", "Senti."], [83.23, 86.46, "DEUS", "Por isso, eu nunca vou deixar você sentir sozinho."], [87.42, 89.6, "DAVI", "Amanhã eu vou sentar com um menino novo."], [89.73, 90.92, "DAVI", "Ele também fica sozinho."], [91.62, 93.39, "DEUS", "Esse é o meu filho."]]