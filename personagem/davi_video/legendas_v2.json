[[1.15, 3.1, "DAVI", "Pai... o Senhor tá acordado?"], [3.75, 5.62, "DEUS", "Eu nunca durmo, Davi."], [5.96, 8.29, "DAVI", "Ah, é. Esqueci."], [8.9, 11.47, "DAVI", "Posso te fazer uma pergunta meio vergonhosa?"], [12.05, 12.8, "DEUS", "Pode."], [13.09, 15.28, "DEUS", "Eu já sei qual é, mas pode."], [15.79, 18.72, "DAVI", "Sabe aquela coisa que eu prometi que nunca mais ia fazer?"], [19.76, 21.21, "DEUS", "Qual das vezes?"], [22.2, 23.51, "DAVI", "...Essa doeu."], [24.56, 26.67, "DAVI", "Eu fiz de novo, Pai. Hoje."], [27.06, 28.14, "DAVI", "O Lucas lá da igreja"], [28.16, 29.77, "DAVI", "nunca faz nada de errado."], [30.88, 32.53, "DAVI", "Por que eu sou assim?"], [33.3, 35.45, "DEUS", "Você não conhece o coração do Lucas."], [35.84, 36.99, "DEUS", "Eu conheço o seu."], [37.44, 40.31, "DEUS", "Sei quando você senta, quando levanta..."], [40.54, 43.47, "DEUS", "sei até quantos cachos tem no seu cabelo."], [43.94, 45.25, "DAVI", "Até os cachos?"], [45.66, 47.65, "DAVI", "Dá muito trabalho contar, hein."], [47.93, 49.24, "DEUS", "Eu gosto de contar."], [50.15, 52.58, "DAVI", "Então... o Senhor não cansa de mim?"], [53.33, 55.43, "DEUS", "Filho, as minhas misericórdias"], [55.45, 57.38, "DEUS", "se renovam a cada manhã."], [58.2, 59.47, "DAVI", "Toda manhã mesmo?"], [59.5, 60.91, "DAVI", "Até segunda-feira?"], [62.05, 63.74, "DEUS", "Principalmente segunda-feira."], [65.51, 67.24, "DAVI", "Eu queria ser um filho melhor."], [68.11, 68.9, "DEUS", "Davi..."], [69.29, 71.01, "DEUS", "eu não te amo porque você é bom."], [71.03, 73.88, "DEUS", "Eu te amo porque você é meu."], [73.93, 76.24, "DEUS", "E nada, nada mesmo,"], [76.41, 78.1, "DEUS", "vai te separar desse amor."], [79.08, 80.15, "DAVI", "Desculpa, Pai."], [80.51, 81.92, "DEUS", "Já está perdoado."], [82.07, 84.4, "DEUS", "Agora deixa eu cuidar do resto."], [85.93, 87.66, "DAVI", "O Senhor fica aqui até eu dormir?"], [88.8, 89.65, "DEUS", "Eu fico."], [89.96, 91.19, "DEUS", "Eu nunca saio."]]